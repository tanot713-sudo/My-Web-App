+#[test]
+fn thai_takes_one_form_and_needs_the_embedded_thai_face() {
+    assert_eq!(Preference::parse("th"), Some(Preference::Thai));
+    let th = LANGUAGES.iter().find(|l| l.code == "th").unwrap();
+    assert_eq!((th.plural_forms, (th.plural)(0), (th.plural)(7)), (1, 0, 0));
